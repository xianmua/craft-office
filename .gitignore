# 依赖与构建产物
node_modules/
target/
dist/
.test-*/

# 前端构建产物（由 npm run build 生成，不入库）
backend/static/

# 内核二进制（体积大，按 vendor/artcraft/README.md 放置）
vendor/artcraft/*.wasm
vendor/artcraft/*.js
# 内核 CLI（部署产物不入库，重建见 docs/BUILD.md）
vendor/wordcraft-cli/
# LibreOffice 便携版（旧格式自动转换，解压即用，见 docs/BUILD.md）
vendor/libreoffice/
mcp-workspace/

# 内核源码与构建产物（体积大，由 patches/ + BUILD.md 重建步骤还原，本地保留不入库）
.kernel-src/
.kernel-archives/

# 验证报告生成物
scripts/verify-results.json
.trae/shots/

# 运行时数据（文档缓存等）
backend/data/

# 环境变量
.env
.env.local

# 服务配置（含内网地址等本地联调信息，模板见 config.toml.example）
backend/config.toml
.verify-shots/

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
