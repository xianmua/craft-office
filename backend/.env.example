# 复制为 .env 后生效（dotenvy 会自动读取）

# 配置文件路径（默认 ./config.toml，相对后端启动目录）
ARTCRAFT_CONFIG=config.toml

# 覆盖监听地址，方便本地调试
# ARTCRAFT_BIND=127.0.0.1:8080

# 日志级别
RUST_LOG=info

# ===== DeepSeek（/api/ai/chat 用；不填则该接口返回 503 not_configured）=====
# API Key（https://platform.deepseek.com 申请）
# DEEPSEEK_API_KEY=sk-xxxx
# 覆盖 API 地址（默认 https://api.deepseek.com，OpenAI 兼容）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat
