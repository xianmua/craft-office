# 复制为 .env 后生效（dotenvy 会自动读取）

# 配置文件路径（默认 ./config.toml，相对后端启动目录）
ARTCRAFT_CONFIG=config.toml

# 覆盖监听地址，方便本地调试
# ARTCRAFT_BIND=127.0.0.1:7778

# 日志级别
RUST_LOG=info

# ===== DeepSeek（/api/ai/chat 用；不填则该接口返回 503 not_configured）=====
# API Key（https://platform.deepseek.com 申请）
# DEEPSEEK_API_KEY=sk-xxxx
# 覆盖 API 地址（默认 https://api.deepseek.com，OpenAI 兼容）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# ===== DSH（dsh-apis-plugin，本机开放接口；助手面板切换 DSH 时走这条链路）=====
# 服务完全开放无鉴权，API Key 可不配置（留空即可）
# DSH_API_KEY=
# API 地址（默认 http://127.0.0.1:3088/v1，dsh-apis-plugin 默认端口 3088）
# DSH_BASE_URL=http://127.0.0.1:3088/v1
# 模型（默认 id456/glm-5.3-flash；可用模型看 GET http://127.0.0.1:3088/v1/models，
# 也支持任意 provider/model 自由填写）
# DSH_MODEL=id456/glm-5.3-flash

# ===== 保存拉取接口（/api/save/latest*；第三方凭令牌拉取最新保存的文档字节）=====
# 不配置或留空 = 接口禁用（所有请求 403，前端也不上报）。配置后前端保存自动上报，
# 第三方服务端调用：GET /api/save/latest?token=xxx（元信息）、GET /api/save/latest/file?token=xxx（字节）
# SAVE_API_TOKEN=change-me-to-a-long-random-string
