# 内核口子补丁 0004：远程操作期间抑制浮动格式工具栏
# canvas.rs remote_until 字段 + app/commands.rs note_remote_activity/remote_active。
# 调用方在 0003 的 web/plugins.rs（route 入口 note_remote_activity）。#
# 应用（在 .kernel-src/wordcraft-main 或对应检出目录下，按编号顺序）：
#   git apply --check ../../patches/<本文件>
#   git apply ../../patches/<本文件>
# 撤销：git apply -R ../../patches/<本文件>
# 升级后 apply 失败时按各 hunk 内容手工重放（每个 hunk 均为独立小改动）。
diff --git a/.kernel-src/wordcraft-main/crates/ui-egui/src/app/commands.rs b/.kernel-src/wordcraft-main/crates/ui-egui/src/app/commands.rs
index 5b28569..798d17d 100644
--- a/.kernel-src/wordcraft-main/crates/ui-egui/src/app/commands.rs
+++ b/.kernel-src/wordcraft-main/crates/ui-egui/src/app/commands.rs
@@ -106,6 +106,16 @@ impl WordApp {
         r
     }
 
+    /// 插件/控制通道活动延长工具栏抑制窗口（活动期 + 2 秒宽限内浮动格式工具栏不弹）。
+    pub fn note_remote_activity(&mut self, ctx: &egui::Context) {
+        self.canvas.remote_until = ctx.input(|i| i.time) + 2.0;
+    }
+
+    /// 是否处于插件/控制通道活动窗口内（见 `note_remote_activity`）。
+    pub fn remote_active(&self, ctx: &egui::Context) -> bool {
+        ctx.input(|i| i.time) < self.canvas.remote_until
+    }
+
     /// Run a command for a script or an agent (control channel, MCP bridge): never asks first.
     /// UI-level commands (`ui.*`) are handled here, the rest by the engine.
