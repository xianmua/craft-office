+    /// Run the parent's queued control-channel requests (`wordcraft:command`) through
+    /// `control::handle`, answering each with a `wordcraft:result` JSON string. Called once per
+    /// frame with the app at hand.
+    pub fn drain_commands(&self, app: &mut WordApp, ctx: &egui::Context) {
+        for (id, channel, params) in std::mem::take(&mut *self.pending.borrow_mut()) {
+            // Remote operations collapse the floating format toolbar (as plugin commands do).
+            app.note_remote_activity(ctx);
+            let (req, _rx) = control::ControlRequest::new(&channel, params);
+            let reply = match control::handle(app, ctx, &req) {
+                control::Outcome::Done(v) => v,
+                control::Outcome::Screenshot { .. } => serde_json::json!({"ok": false, "error": "screenshot is not supported here"}),
+            };
+            self.post_result(&id, &reply);
+        }
+    }
+
+    /// Answer one `wordcraft:command`: the control reply (`{ok, result|error}`) wrapped with the
+    /// request's `id` and sent as a JSON string, the same transport the presenter popups use.
+    fn post_result(&self, id: &str, reply: &Value) {
+        let mut body = serde_json::json!({"type": "wordcraft:result", "id": id});
+        if let Some(map) = reply.as_object() {
+            for (k, v) in map {
+                body[k.clone()] = v.clone();
+            }
+        }
+        self.parent.post_message(&JsValue::from_str(&body.to_string()), &self.origin).ok();
+    }
