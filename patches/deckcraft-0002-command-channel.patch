+    /// Run the parent's queued commands (`deckcraft:command`) through `SlideApp::run`, answering
+    /// each with a `deckcraft:result` JSON string. Called once per frame with the app at hand.
+    pub fn drain_commands(&self, app: &mut SlideApp) {
+        for (id, channel, params) in std::mem::take(&mut *self.commands.borrow_mut()) {
+            let reply = if channel == "engine.execute" {
+                let command = params.get("command").and_then(Value::as_str).unwrap_or_default().to_string();
+                if command.is_empty() {
+                    serde_json::json!({"ok": false, "error": "missing `command`"})
+                } else {
+                    match app.run(&command, params.get("params").cloned().unwrap_or_else(|| serde_json::json!({}))) {
+                        Ok(v) => serde_json::json!({"ok": true, "result": v}),
+                        Err(e) => serde_json::json!({"ok": false, "error": e}),
+                    }
+                }
+            } else {
+                serde_json::json!({"ok": false, "error": format!("unsupported channel: {channel}")})
+            };
+            self.post_result(&id, &reply);
+        }
+    }
+
+    /// Answer one `deckcraft:command`: the reply (`{ok, result|error}`) wrapped with the
+    /// request's `id` and sent as a JSON string, the same transport the presenter popups use.
+    fn post_result(&self, id: &str, reply: &Value) {
+        let mut body = serde_json::json!({"type": "deckcraft:result", "id": id});
+        if let Some(map) = reply.as_object() {
+            for (k, v) in map {
+                body[k.clone()] = v.clone();
+            }
+        }
+        self.parent.post_message(&JsValue::from_str(&body.to_string()), &self.origin).ok();
+    }
+
