--- /dev/null
+++ b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/mod.rs
@@ -0,0 +1,57 @@
+//! 内核插件管理器 + 插件 API（cordis 风格）：内核只内置通用注册表、动态面板、
+//! 声明式渲染与管理器 UI；插件本体是宿主层（web）装载的 JS，经 [`crate::Services::plugin_load`]
+//! 装载，注册与运行事件经 [`PluginEvent`] 队列逐帧送回内核（与 `Services::inbox` 同一队列模式）。
+//! 内核 → 插件方向走 [`crate::Services::plugin_invoke`]。
+
+mod manager;
+mod panes;
+mod registry;
+mod render;
+
+pub use panes::{PanelState, Panes};
+pub use registry::{PluginEntry, Registry};
+pub(crate) use manager::show;
+pub(crate) use render::panel_ui;
+
+/// 插件命令声明（帮助菜单出现，`ui.plugin.run` 执行）。
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CommandSpec {
+    pub id: String,
+    pub title: String,
+}
+
+/// 插件面板声明（内核以 `Pane::Plugin(handle)` 打开并渲染）。
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PanelSpec {
+    pub id: String,
+    pub title: String,
+    /// 停靠默认宽度；缺省 300。
+    #[serde(default)]
+    pub default_width: Option<f32>,
+}
+
+/// 宿主 → 内核的一条插件事件（队列模式，见模块文档）。
+pub enum PluginEvent {
+    /// 插件运行时已（重新）装载：清空注册表等待重新注册；旧面板句柄作废即关闭。
+    Ready,
+    /// 一个插件声明了它的命令。
+    Commands { plugin: String, commands: Vec<CommandSpec> },
+    /// 一个插件声明了它的面板；句柄由内核分配后回填注册表。
+    Panels { plugin: String, panels: Vec<PanelSpec> },
+    /// 面板状态补丁（浅合并到 per-window 面板状态）；`panel` 是面板 id 字符串，
+    /// 排空时经注册表解析句柄（装载当帧注册表可能尚未建好，晚解析更稳）。
+    PanelState { panel: String, state: serde_json::Value },
+    /// 插件启停确认（宿主写完 installed.json 并重载后回填注册表）。
+    Enabled { id: String, enabled: bool },
+    /// 一次性提示（插件经 `ctx.ui.toast` 请求）。
+    Toast { message: String },
+    /// 一次性弹窗（插件经 `ctx.ui.dialog` 请求），关闭即丢弃。
+    Dialog { title: String, text: String },
+    /// 插件报错。
+    Error { plugin: String, message: String },
+}
+
+/// 事件队列：宿主 push，内核每帧排空（`WordApp::drain_plugins`）。
+pub type PluginEvents = std::sync::Arc<std::sync::Mutex<Vec<PluginEvent>>>;

diff --git a/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/panes.rs b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/panes.rs
new file mode 100644
index 0000000..092c943
--- /dev/null
+++ b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/panes.rs
@@ -0,0 +1,72 @@
+//! 插件面板的 per-window 运行时状态：每个窗口各自开着哪些插件面板，及其
+//! 声明式状态（插件经 `panel.setState` 浅合并推送）与输入框文字。
+
+use std::collections::HashMap;
+
+use serde_json::Value;
+
+/// 一个打开插件面板的运行时状态。
+#[derive(Clone, Debug, Default)]
+pub struct PanelState {
+    /// 插件推送的声明式状态（消息流、busy、error 等），渲染约定见 `render`。
+    pub state: Value,
+    /// 底部输入框里的文字。
+    pub prompt: String,
+}
+
+/// 一个窗口开着的插件面板：`(面板句柄, 状态)`。`last` 缓存各面板最后一次
+/// 推送的状态：面板没开时推送不丢，打开面板时播种续显。
+#[derive(Clone, Debug, Default)]
+pub struct Panes {
+    pub open: Vec<(u16, PanelState)>,
+    pub last: HashMap<u16, Value>,
+}
+
+impl Panes {
+    pub fn is_open(&self, handle: u16) -> bool {
+        self.open.iter().any(|(h, _)| *h == handle)
+    }
+
+    pub fn open(&mut self, handle: u16) {
+        if !self.is_open(handle) {
+            let state = self.last.get(&handle).cloned().unwrap_or_default();
+            self.open.push((handle, PanelState { state, prompt: String::new() }));
+        }
+    }
+
+    pub fn close(&mut self, handle: u16) {
+        if let Some(slot) = self.open.iter_mut().find(|(h, _)| *h == handle) {
+            self.last.insert(handle, slot.1.state.clone());
+        }
+        self.open.retain(|(h, _)| *h != handle);
+    }
+
+    pub fn get(&self, handle: u16) -> Option<&PanelState> {
+        self.open.iter().find(|(h, _)| *h == handle).map(|(_, s)| s)
+    }
+
+    pub fn get_mut(&mut self, handle: u16) -> Option<&mut PanelState> {
+        self.open.iter_mut().find(|(h, _)| *h == handle).map(|(_, s)| s)
+    }
+
+    /// 浅合并一条状态补丁：两侧都是对象时逐键覆盖，否则整体替换。
+    /// 面板没开时补丁进 `last` 缓存，打开时可见。
+    pub fn apply_state(&mut self, handle: u16, patch: &Value) {
+        match self.open.iter_mut().find(|(h, _)| *h == handle) {
+            Some(slot) => {
+                let state = &mut slot.1.state;
+                if let (Some(map), Some(object)) = (state.as_object_mut(), patch.as_object()) {
+                    for (k, v) in object {
+                        map.insert(k.clone(), v.clone());
+                    }
+                } else {
+                    *state = patch.clone();
+                }
+                self.last.insert(handle, state.clone());
+            }
+            None => {
+                self.last.insert(handle, patch.clone());
+            }
+        }
+    }
+}

diff --git a/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/registry.rs b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/registry.rs
new file mode 100644
index 0000000..012ad4b
