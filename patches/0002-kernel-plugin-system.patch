+++ b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/registry.rs
@@ -0,0 +1,91 @@
+//! App 级插件注册表：装载后的插件条目（命令 + 面板）。面板句柄单调递增不复用，
+//! 插件重载后句柄作废，旧面板随之关闭（预期行为，见方案）。
+
+use super::{CommandSpec, PanelSpec};
+
+/// 一个已注册插件。
+#[derive(Clone, Debug, Default)]
+pub struct PluginEntry {
+    pub id: String,
+    pub name: String,
+    pub enabled: bool,
+    pub commands: Vec<CommandSpec>,
+    /// `(面板句柄, 声明)`；句柄在注册时分配。
+    pub panels: Vec<(u16, PanelSpec)>,
+}
+
+#[derive(Default)]
+pub struct Registry {
+    pub plugins: Vec<PluginEntry>,
+    /// 下一个面板句柄；单调递增，重载不复用。
+    next_handle: u16,
+    /// 插件管理器窗口是否开着（`ui.plugins`）。
+    pub manager_open: bool,
+    /// 待展示的插件弹窗（`ctx.ui.dialog`），关闭即丢弃。
+    pub dialogs: Vec<(String, String)>,
+}
+
+impl Registry {
+    /// 分配一个新面板句柄。
+    fn allocate(&mut self) -> u16 {
+        let h = self.next_handle;
+        self.next_handle = self.next_handle.saturating_add(1);
+        h
+    }
+
+    /// 条目下标，缺失则建一个（`name` 暂用 id）。
+    fn ensure(&mut self, id: &str) -> usize {
+        if let Some(at) = self.plugins.iter().position(|p| p.id == id) {
+            return at;
+        }
+        self.plugins.push(PluginEntry { id: id.to_string(), name: id.to_string(), ..Default::default() });
+        self.plugins.len() - 1
+    }
+
+    /// 重载：清空条目；句柄计数与管理器开合保留。
+    pub fn clear(&mut self) {
+        self.plugins.clear();
+    }
+
+    /// 一个插件声明了它的命令。
+    pub fn set_commands(&mut self, id: &str, commands: Vec<CommandSpec>) {
+        let at = self.ensure(id);
+        self.plugins[at].commands = commands;
+    }
+
+    /// 一个插件声明了它的面板；为每个面板分配句柄（同 id 面板保持原句柄，
+    /// 全量 announce 重复注册时不顶掉已开面板）。
+    pub fn add_panels(&mut self, id: &str, panels: Vec<PanelSpec>) {
+        let at = self.ensure(id);
+        let old = std::mem::take(&mut self.plugins[at].panels);
+        let slots = panels
+            .into_iter()
+            .map(|spec| {
+                let handle = old.iter().find(|(_, s)| s.id == spec.id).map(|(h, _)| *h).unwrap_or_else(|| self.allocate());
+                (handle, spec)
+            })
+            .collect::<Vec<_>>();
+        self.plugins[at].panels = slots;
+    }
+
+    /// 启停确认回填。
+    pub fn set_enabled(&mut self, id: &str, enabled: bool) {
+        let at = self.ensure(id);
+        self.plugins[at].enabled = enabled;
+    }
+
+    /// 句柄 → 面板声明。
+    pub fn panel(&self, handle: u16) -> Option<&PanelSpec> {
+        self.plugins.iter().flat_map(|p| p.panels.iter()).find(|(h, _)| *h == handle).map(|(_, spec)| spec)
+    }
+
+    /// 面板 id → 句柄（`ui.plugin.openPane` 用）。
+    pub fn panel_handle(&self, id: &str) -> Option<u16> {
+        self.plugins.iter().flat_map(|p| p.panels.iter()).find(|(_, spec)| spec.id == id).map(|(h, _)| *h)
+    }
+
+    /// 面板 id → 所属插件 id（`ui.plugin.panelSend` 用）。
+    pub fn panel_plugin(&self, id: &str) -> Option<&str> {
+        self.plugins.iter().find(|p| p.panels.iter().any(|(_, spec)| spec.id == id)).map(|p| p.id.as_str())
+    }
+}

diff --git a/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/render.rs b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/render.rs
new file mode 100644
index 0000000..5bbd16a
--- /dev/null
+++ b/.kernel-src/wordcraft-main/crates/ui-egui/src/plugins/render.rs
@@ -0,0 +1,103 @@
+//! 通用声明式插件面板渲染：面板内容由插件经 `panel.setState` 推送的 JSON 决定，
+//! 内核约定这几个字段：`messages: [{role, text}]` 消息流；`busy` 生成中（自动重绘）；
+//! `error` 错误提示；`name` 助手名；`placeholder` 输入框提示。消息流为通栏纯文本
+//! （无气泡）；生成中的末条助手消息实时增长并带光标。输入框默认 1 行（回车换行、
+//! 随内容长高），Ctrl+回车或点「发送」提交；发送经
+//! `Services::plugin_invoke("panel.send", …)` 交回插件。
+
+use egui::{ScrollArea, Ui};
+use serde_json::Value;
+
+use crate::WordApp;
+use crate::theme::{Tokens, regular};
+
+pub(crate) fn panel_ui(app: &mut WordApp, ui: &mut Ui, handle: u16) {
+    let Some(slot) = app.plugin_panes.get_mut(handle) else {
+        return;
+    };
+    let t = Tokens::get(ui.ctx());
+    let state = slot.state.clone();
+    let messages = state.get("messages").and_then(Value::as_array).cloned().unwrap_or_default();
+    let busy = state.get("busy").and_then(Value::as_bool).unwrap_or(false);
+    let error = state.get("error").and_then(Value::as_str).unwrap_or_default().to_string();
+    let name = state.get("name").and_then(Value::as_str).unwrap_or("助手").to_string();
+    ui.add_space(4.0);
+    // 输入区默认 1 行高，随换行自动长高（最多 6 行，再多内部滚动），给消息流让位避免内容被盖住。
+    let rows = (slot.prompt.matches('\n').count() + 1).clamp(1, 6);
+    let input_height = rows as f32 * 15.0 + 16.0;
+    let log_height = (ui.available_height() - input_height).max(60.0);
+    ScrollArea::vertical().auto_shrink([false; 2]).stick_to_bottom(true).max_height(log_height).min_scrolled_height(60.0).show(ui, |ui| {
+        if messages.is_empty() {
+            ui.label(
+                egui::RichText::new("用一句话下指令\n回复直接写进文档")
+                    .font(regular(11.0))
+                    .color(t.text_dim),
+            );
+            return;
+        }
+        let last = messages.len() - 1;
+        for (i, message) in messages.iter().enumerate() {
+            let role = message.get("role").and_then(Value::as_str).unwrap_or("assistant");
+            let text = message.get("text").and_then(Value::as_str).unwrap_or_default();
+            let author = if role == "user" { "你" } else { name.as_str() };
+            ui.label(egui::RichText::new(author).font(regular(10.0)).color(t.text_dim));
+            // 流式末条：空文本先给省略号，有内容后缀光标；其余按原文展示。
+            let streaming = busy && i == last && role != "user";
+            let shown = if streaming {
+                if text.is_empty() { "…".to_string() } else { format!("{text} |") }
+            } else {
+                text.to_string()
+            };
+            if shown.is_empty() {
+                ui.label(egui::RichText::new(" ").font(regular(10.0)));
+            } else {
+                ui.add(egui::Label::new(egui::RichText::new(&shown)).wrap());
+            }
+            ui.add_space(10.0);
+        }
+    });
+    ui.add_space(2.0);
+    ui.separator();
+    ui.add_space(4.0);
+    let placeholder = state.get("placeholder").and_then(Value::as_str).unwrap_or("输入内容发给插件…");
+    let mut send = false;
+    ui.horizontal(|ui| {
+        let response = ui.add(
+            egui::TextEdit::multiline(&mut slot.prompt)
+                .desired_width(ui.available_width() - 52.0)
+                .desired_rows(rows)
+                .char_limit(4000)
+                .hint_text(placeholder),
+        );
+        // 回车换行；Ctrl+回车或点「发送」提交，发送后保持输入焦点。
+        send = (response.has_focus()
+            && ui.input(|i| i.key_pressed(egui::Key::Enter) && i.modifiers.command))
+            || ui
+                .add_enabled(
+                    !busy && !slot.prompt.trim().is_empty(),
+                    egui::Button::new("发送"),
+                )
+                .clicked();
+        if send {
+            response.request_focus();
+        }
+    });
+    if send && !busy && !slot.prompt.trim().is_empty() {
+        // 载荷带面板 id（非句柄），与 `ui.plugin.panelSend`、插件侧约定一致。
+        let panel_id = app.plugins.panel(handle).map(|s| s.id.clone());
+        if let (Some(invoke), Some(panel)) = (app.services.plugin_invoke.as_ref(), panel_id) {
+            invoke("panel.send", serde_json::json!({"panel": panel, "text": slot.prompt.trim()}));
+        }
+        slot.prompt.clear();
+    }
+    // 状态行只放状态词。
+    if busy {
+        ui.add_space(2.0);
+        ui.label(egui::RichText::new("生成中").font(regular(10.0)).color(t.text_dim));
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(200));
+    }
+    if !error.is_empty() {
+        ui.add_space(4.0);
+        ui.colored_label(ui.visuals().error_fg_color, &error);
+    }
+}
