diff --git a/.kernel-src/wordcraft-main/crates/ui-egui/src/ribbon/review.rs b/.kernel-src/wordcraft-main/crates/ui-egui/src/ribbon/review.rs
index 0252a2d..61837c4 100644
--- a/.kernel-src/wordcraft-main/crates/ui-egui/src/ribbon/review.rs
